# Copy to scraper/.env (gitignored). Real environment variables take precedence.

# ── LLM (pick one; first available wins: API key → claude CLI → codex CLI) ──
# Anthropic API key. When set, extraction uses the Messages API directly.
ANTHROPIC_API_KEY=
# Model for the API backend (default: claude-opus-5-5).
ARNONA_MODEL=
# Force a backend: anthropic | claude | codex
ARNONA_LLM=
# Optional model overrides for the CLI backends.
ARNONA_CLAUDE_MODEL=
ARNONA_CODEX_MODEL=

# ── Discovery ──
# Set to 0 to skip the LLM web-search discovery rung.
ARNONA_LIVE_RESEARCH=
# Optional HTTPS relay for official PDFs a municipality blocks from your network.
# Receives ?city_key=&year=&url= and must return the PDF bytes. Off when empty.
ARNONA_RELAY_URL=
ARNONA_RELAY_TOKEN=
# Contact string appended to the User-Agent sent to the Wikipedia API (e.g. your
# repo URL or e-mail), as Wikimedia asks automated clients to identify themselves.
ARNONA_USER_AGENT_CONTACT=
